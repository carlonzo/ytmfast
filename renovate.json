{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "groupName": "egui",
      "matchDatasources": ["crate"],
      "matchPackageNames": [
        "egui",
        "eframe",
        "egui_extras",
        "egui-winit",
        "egui_glow",
        "egui-wgpu",
        "epaint",
        "emath",
        "ecolor"
      ]
    }
  ]
}
